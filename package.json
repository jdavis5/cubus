{
  "name": "cubus",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "next lint",
    "init": "pnpm prisma:init",
    "postinstall": "pnpm prisma:generate",
    "prepare": "husky",
    "prisma:generate": "pnpm prisma:main:generate && pnpm prisma:mflix:generate",
    "prisma:init": "pnpm prisma:main:init && pnpm prisma:mflix:init",
    "prisma:main:generate": "prisma generate",
    "prisma:main:init": "pnpm prisma:main:generate && pnpm prisma:main:push && pnpm prisma:main:seed",
    "prisma:main:push": "dotenv -c -- prisma db push",
    "prisma:main:seed": "prisma db seed",
    "prisma:mflix:init": "pnpm prisma:mflix:pull && pnpm prisma:mflix:generate",
    "prisma:mflix:generate": "prisma generate --schema=prisma/mflix/schema.prisma",
    "prisma:mflix:pull": "dotenv -c -- prisma db pull --force --schema=prisma/mflix/schema.prisma",
    "start": "next start"
  },
  "dependencies": {
    "@hookform/resolvers": "^2.9.11",
    "@prisma/client": "5.22.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "11.0.0-next-beta.294",
    "@trpc/next": "11.0.0-next-beta.294",
    "@trpc/react-query": "11.0.0-next-beta.294",
    "@trpc/server": "11.0.0-next-beta.294",
    "bcrypt": "^5.1.1",
    "clsx": "^1.2.1",
    "cookie": "^0.5.0",
    "date-fns": "^2.30.0",
    "jiti": "^1.21.7",
    "nanoid": "^5.1.5",
    "next": "^14.2.25",
    "nodemailer": "^6.10.0",
    "prisma": "5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^3.1.4",
    "react-hook-form": "^7.54.2",
    "react-icons": "^4.12.0",
    "react-transition-group": "^4.4.5",
    "sass": "^1.86.0",
    "superjson": "^1.13.3",
    "superjson2": "npm:superjson@^2.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-react": "^4.19.1",
    "zod": "^3.24.2",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@babel/plugin-transform-class-static-block": "^7.26.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie": "^0.5.4",
    "@types/node": "18.6.3",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "18.0.15",
    "@types/react-dom": "18.0.6",
    "@types/react-transition-group": "^4.4.12",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-react": "^4.19.0",
    "@types/zxcvbn": "^4.4.5",
    "babel-plugin-superjson-next": "^0.4.5",
    "dotenv-cli": "^7.4.4",
    "env-nextjs": "https://github.com/jdavis5/env-nextjs/releases/download/1.0.1/env-nextjs-1.0.1.tgz",
    "eslint": "^8.0.0",
    "eslint-config-next": "^15.4.5",
    "eslint-config-prettier": "^8.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "2.8.7",
    "tsx": "^4.19.3",
    "typescript": ">=5.8.2 <5.9.0",
    "zod-prisma-types": "^3.2.4"
  },
  "prisma": {
    "schema": "prisma/main/schema.prisma",
    "seed": "dotenv -c -- tsx prisma/main/seed.ts"
  }
}
