{
    "extends": ["next/core-web-vitals", "prettier"],
    "rules": {
        "no-duplicate-imports": "error",
        "no-unused-vars": ["error", { "args": "none" }],
        "react/no-unescaped-entities": "off"
    },
    "overrides": [
        {
            "files": ["*.d.ts"],
            "rules": {
                "no-unused-vars": "off"
            }
        }
    ],
    "ignorePatterns": ["prisma/**/generated"]
}
